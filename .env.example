# Modelo das variáveis do compose.yaml. Copie para .env (mesma pasta) e preencha.
# O .env não vai para o Git. Troque TODOS os valores abaixo por segredos seus.

# Senha do usuário root do MySQL do contêiner.
MYSQL_ROOT_PASSWORD=troque-esta-senha-do-root

# Senha do usuário "equiptrack", que o backend usa para falar com o banco.
DB_SENHA=troque-esta-senha-do-banco

# Chave dos desenvolvedores para a gestão de usuários (/api/usuarios). Mínimo de 16 caracteres,
# senão o backend não sobe. Use algo longo e aleatório.
EQUIPTRACK_CHAVE_DESENVOLVEDOR=troque-esta-chave-longa-e-secreta

# ---- Opcionais (os valores abaixo são os padrões) ----

# Fuso usado para decidir em que dia vence um empréstimo.
# FUSO_HORARIO=America/Sao_Paulo

# Portas no seu computador. Mude se alguma já estiver em uso.
# FRONTEND_PORT=4200
# BACKEND_PORT=8080
# MYSQL_PORT=3307

# Pasta do repositório do front, caso não esteja ao lado deste (build do front).
# FRONTEND_CONTEXT=../frontend

# Swagger/OpenAPI (documentação da API) fica desligado. Para ligar em ambiente de teste:
# SWAGGER_ATIVO=true
